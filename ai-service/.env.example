# Copy to `.env` inside ai-service/ and fill in your keys.

# https://newsapi.org — free tier: 100 requests/day
NEWS_API_KEY=

# https://platform.claude.com — Claude API key for sentiment analysis
ANTHROPIC_API_KEY=

# Port for the FastAPI server (must match app.ai-service.base-url in the Java backend)
AI_SERVICE_PORT=8000
