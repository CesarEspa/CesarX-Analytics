# Copy to `.env` (or export these as real environment variables) before running the backend.
# The values below match docker-compose.yml defaults for local development.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cesarx_analytics
DB_USER=cesarx
DB_PASSWORD=cesarx

# Generate your own 32+ byte secret for real deployments, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-before-deploying-to-production-min-32-bytes
JWT_EXPIRATION_MS=86400000

# Python AI microservice, wired up in Phase 2
AI_SERVICE_URL=http://localhost:8000

ALERTS_CHECK_INTERVAL_MS=300000
